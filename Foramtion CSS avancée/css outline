<!DOCTYPE html>
<html>
<head>
<style>
p {
outline-color:green;
padding: 5px;
}
p.dotted {outline-style: dotted;outline-width:medium; outline-color: blue; outline-offset: 20px;}
p.dashed {outline-style: dashed; outline-width: thin; outline-color: red; outline-offset: 15px;}
</style>
</head>
<body>

<h2>The outline-style Property</h2>

<p class="dotted">A dotted outline</p>
<p class="dashed">A dashed outline</p>


</body>
</html>



