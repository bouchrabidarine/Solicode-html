<!DOCTYPE html>
<html>
<head>
<style>
table,th,td {
  border: 1px solid;
  border-collapse:collapse;
}
th {
  height: 70px;
}
</style>
</head>
<body>

<h2>Single Border Around The Table</h2>

<table style="width:100%">
  <tr>
    <th >Firstname</th>
    <th>Lastname</th>
  </tr>
  <tr>
    <td>Peter</td>
    <td>Griffin</td>
  </tr>
  <tr>
    <td>Lois</td>
    <td>Griffin</td>
  </tr>
</table>

</body>
</html>
